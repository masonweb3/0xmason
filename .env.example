# Copy to .env, which is ignored by Git and Vercel uploads.
# npm run cms:db generates MASON_CMS_SECRET if it is missing.
MASON_CMS_ORIGIN=http://127.0.0.1:3000

# A bucket-scoped R2 credential is required for actual uploads.
MASON_CMS_R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
MASON_CMS_R2_BUCKET=your-media-bucket
MASON_CMS_R2_ACCESS_KEY_ID=replace-me
MASON_CMS_R2_SECRET_ACCESS_KEY=replace-me

# Local development uses a private Unix socket unless a database URL is provided.
# Production: use a dedicated schema-owning application role, not postgres.
# MASON_CMS_DATABASE_URL=
# MASON_CMS_RUNTIME_DIR=
# MASON_CMS_ADMIN_EMAIL=
# MASON_CMS_ADMIN_PASSWORD=
SITE_INDEXING_ENABLED=false
